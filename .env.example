# Telegram Job Bot Configuration
# Copy this file to .env and fill in your actual credentials

# Userbot credentials from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Chat ID to receive alerts (your user ID or group chat ID)
# Get your user ID from @userinfobot
ALERT_CHAT_ID=

